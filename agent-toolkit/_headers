# Cache static assets aggressively
/agent-toolkit/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — instant revalidation
/agent-toolkit/*.html
  Cache-Control: public, max-age=0, must-revalidate

/agent-toolkit/*.json
  Cache-Control: public, max-age=0, must-revalidate

/agent-toolkit/*.md
  Cache-Control: public, max-age=0, must-revalidate

/agent-toolkit/tools/*.html
  Cache-Control: public, max-age=0, must-revalidate

/agent-toolkit/tools/*.json
  Cache-Control: public, max-age=0, must-revalidate

/agent-toolkit/instructions/*.md
  Cache-Control: public, max-age=0, must-revalidate
